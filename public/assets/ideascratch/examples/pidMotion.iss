{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"pidSensor\">sensor</variable>\n    <variable id=\"pidDrift\">drift</variable>\n  </variables>\n  <block type=\"sumo_accel_setup\" x=\"20\" y=\"20\">\n    <field name=\"SENSOR_VAR\" id=\"pidSensor\">sensor</field>\n    <next>\n      <block type=\"variables_set\">\n        <field name=\"VAR\" id=\"pidDrift\">drift</field>\n        <value name=\"VALUE\">\n          <block type=\"sumo_calibrate_gyro\">\n            <field name=\"SENSOR_VAR\" id=\"pidSensor\">sensor</field>\n            <value name=\"SECONDS\">\n              <shadow type=\"math_number\"><field name=\"NUM\">5</field></shadow>\n            </value>\n          </block>\n        </value>\n        <next>\n          <block type=\"sumo_straight_move\">\n            <field name=\"SENSOR_VAR\" id=\"pidSensor\">sensor</field>\n            <value name=\"DRIFT\">\n              <block type=\"variables_get\">\n                <field name=\"VAR\" id=\"pidDrift\">drift</field>\n              </block>\n            </value>\n            <value name=\"DURATION\">\n              <shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow>\n            </value>\n            <next>\n              <block type=\"sumo_turn_degrees\">\n                <field name=\"SENSOR_VAR\" id=\"pidSensor\">sensor</field>\n                <value name=\"DRIFT\">\n                  <block type=\"variables_get\">\n                    <field name=\"VAR\" id=\"pidDrift\">drift</field>\n                  </block>\n                </value>\n                <value name=\"DEGREES\">\n                  <shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow>\n                </value>\n                <value name=\"SPEED\">\n                  <shadow type=\"math_number\"><field name=\"NUM\">0.25</field></shadow>\n                </value>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}