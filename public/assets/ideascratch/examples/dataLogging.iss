{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"dataVal\">value</variable>\n  </variables>\n  <block type=\"controls_forever\" x=\"20\" y=\"20\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\" id=\"dataVal\">value</field>\n        <value name=\"VALUE\">\n          <block type=\"math_random_int\">\n            <value name=\"FROM\">\n              <shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow>\n            </value>\n            <value name=\"TO\">\n              <shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow>\n            </value>\n          </block>\n        </value>\n        <next>\n          <block type=\"data_log\">\n            <mutation items=\"1\"></mutation>\n            <field name=\"FILENAME\">data.csv</field>\n            <value name=\"ADD0\">\n              <block type=\"variables_get\">\n                <field name=\"VAR\" id=\"dataVal\">value</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"text_print\">\n                <value name=\"TEXT\">\n                  <block type=\"variables_get\">\n                    <field name=\"VAR\" id=\"dataVal\">value</field>\n                  </block>\n                </value>\n                <next>\n                  <block type=\"time_sleep\">\n                    <value name=\"SECONDS\">\n                      <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                    </value>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>","dashboard":""}