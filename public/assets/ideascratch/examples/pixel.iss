{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"controls_forever\" x=\"20\" y=\"20\">\n    <statement name=\"DO\">\n      <block type=\"ib_pixel\">\n        <field name=\"COLOUR\">255, 0, 0</field>\n        <next>\n          <block type=\"time_sleep\">\n            <value name=\"SECONDS\">\n              <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n            </value>\n            <next>\n              <block type=\"ib_pixel\">\n                <field name=\"COLOUR\">0, 255, 0</field>\n                <next>\n                  <block type=\"time_sleep\">\n                    <value name=\"SECONDS\">\n                      <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                    </value>\n                    <next>\n                      <block type=\"ib_pixel\">\n                        <field name=\"COLOUR\">0, 0, 255</field>\n                        <next>\n                          <block type=\"time_sleep\">\n                            <value name=\"SECONDS\">\n                              <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                            </value>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>","dashboard":""}