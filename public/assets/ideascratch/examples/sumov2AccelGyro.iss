{
  "version": 2,
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"sumoVar\">sumo</variable>\n  </variables>\n  <block type=\"sumov2_setup\" x=\"20\" y=\"20\">\n    <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"text_print\">\n            <value name=\"TEXT\">\n              <block type=\"text_join\">\n                <mutation items=\"6\"/>\n                <value name=\"ADD0\">\n                  <block type=\"text\">\n                    <field name=\"TEXT\">Accel X: </field>\n                  </block>\n                </value>\n                <value name=\"ADD1\">\n                  <block type=\"sumov2_accel_read\">\n                    <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                    <field name=\"AXIS\">0</field>\n                  </block>\n                </value>\n                <value name=\"ADD2\">\n                  <block type=\"text\">\n                    <field name=\"TEXT\">  Y: </field>\n                  </block>\n                </value>\n                <value name=\"ADD3\">\n                  <block type=\"sumov2_accel_read\">\n                    <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                    <field name=\"AXIS\">1</field>\n                  </block>\n                </value>\n                <value name=\"ADD4\">\n                  <block type=\"text\">\n                    <field name=\"TEXT\">  Z: </field>\n                  </block>\n                </value>\n                <value name=\"ADD5\">\n                  <block type=\"sumov2_accel_read\">\n                    <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                    <field name=\"AXIS\">2</field>\n                  </block>\n                </value>\n              </block>\n            </value>\n            <next>\n              <block type=\"text_print\">\n                <value name=\"TEXT\">\n                  <block type=\"text_join\">\n                    <mutation items=\"6\"/>\n                    <value name=\"ADD0\">\n                      <block type=\"text\">\n                        <field name=\"TEXT\">Gyro X: </field>\n                      </block>\n                    </value>\n                    <value name=\"ADD1\">\n                      <block type=\"sumov2_gyro_read\">\n                        <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                        <field name=\"AXIS\">0</field>\n                      </block>\n                    </value>\n                    <value name=\"ADD2\">\n                      <block type=\"text\">\n                        <field name=\"TEXT\">  Y: </field>\n                      </block>\n                    </value>\n                    <value name=\"ADD3\">\n                      <block type=\"sumov2_gyro_read\">\n                        <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                        <field name=\"AXIS\">1</field>\n                      </block>\n                    </value>\n                    <value name=\"ADD4\">\n                      <block type=\"text\">\n                        <field name=\"TEXT\">  Z: </field>\n                      </block>\n                    </value>\n                    <value name=\"ADD5\">\n                      <block type=\"sumov2_gyro_read\">\n                        <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                        <field name=\"AXIS\">2</field>\n                      </block>\n                    </value>\n                  </block>\n                </value>\n                <next>\n                  <block type=\"time_sleep\">\n                    <value name=\"SECONDS\">\n                      <block type=\"math_number\">\n                        <field name=\"NUM\">0.5</field>\n                      </block>\n                    </value>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>"
}