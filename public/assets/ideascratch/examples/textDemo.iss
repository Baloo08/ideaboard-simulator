{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"explorer_setup\" x=\"20\" y=\"20\">\n    <next>\n      <block type=\"text_print\">\n        <value name=\"TEXT\">\n          <shadow type=\"text\"><field name=\"TEXT\">Displaying single characters...</field></shadow>\n        </value>\n        <next>\n          <block type=\"explorer_show_char\">\n            <value name=\"CHAR\">\n              <shadow type=\"text\"><field name=\"TEXT\">H</field></shadow>\n            </value>\n            <next>\n              <block type=\"time_sleep\">\n                <value name=\"SECONDS\">\n                  <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                </value>\n                <next>\n                  <block type=\"explorer_show_char\">\n                    <value name=\"CHAR\">\n                      <shadow type=\"text\"><field name=\"TEXT\">I</field></shadow>\n                    </value>\n                    <next>\n                      <block type=\"time_sleep\">\n                        <value name=\"SECONDS\">\n                          <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                        </value>\n                        <next>\n                          <block type=\"explorer_show_char\">\n                            <value name=\"CHAR\">\n                              <shadow type=\"text\"><field name=\"TEXT\">!</field></shadow>\n                            </value>\n                            <next>\n                              <block type=\"time_sleep\">\n                                <value name=\"SECONDS\">\n                                  <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                                </value>\n                                <next>\n                                  <block type=\"text_print\">\n                                    <value name=\"TEXT\">\n                                      <shadow type=\"text\"><field name=\"TEXT\">Scrolling text...</field></shadow>\n                                    </value>\n                                    <next>\n                                      <block type=\"explorer_scroll_text\">\n                                        <value name=\"TEXT\">\n                                          <shadow type=\"text\"><field name=\"TEXT\">HELLO</field></shadow>\n                                        </value>\n                                        <value name=\"SPEED\">\n                                          <shadow type=\"math_number\"><field name=\"NUM\">0.08</field></shadow>\n                                        </value>\n                                        <next>\n                                          <block type=\"explorer_matrix_fill\">\n                                            <field name=\"VALUE\">0</field>\n                                            \n                                          </block>\n                                        </next>\n                                      </block>\n                                    </next>\n                                  </block>\n                                </next>\n                              </block>\n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}