{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"mqttVar\">mqtt</variable>\n  </variables>\n  <block type=\"mqtt_setup\" x=\"-30\" y=\"10\">\n    <field name=\"CLIENT_VAR\" id=\"mqttVar\">mqtt</field>\n    <field name=\"SSID\">your_ssid</field>\n    <field name=\"WIFI_PASS\">your_password</field>\n    <field name=\"BROKER\">broker.hivemq.com</field>\n    <field name=\"PORT\">1883</field>\n    <field name=\"MQTT_USER\"></field>\n    <field name=\"MQTT_PASS\"></field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"controls_every\">\n            <value name=\"SECONDS\">\n              <shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow>\n            </value>\n            <statement name=\"DO\">\n              <block type=\"mqtt_publish\">\n                <field name=\"CLIENT_VAR\" id=\"mqttVar\">mqtt</field>\n                <value name=\"TOPIC\">\n                  <shadow type=\"text\"><field name=\"TEXT\">ideaboard/messages/number</field></shadow>\n                </value>\n                <value name=\"MESSAGE\">\n                  <shadow type=\"text\"><field name=\"TEXT\">Hello!</field></shadow>\n                  <block type=\"math_random_int\">\n                    <value name=\"FROM\">\n                      <shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow>\n                    </value>\n                    <value name=\"TO\">\n                      <shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow>\n                    </value>\n                  </block>\n                </value>\n              </block>\n            </statement>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":"{\"widgets\":[{\"type\":\"line-graph\",\"col\":1,\"row\":1,\"width\":18,\"height\":10,\"config\":{\"label\":\"Line Graph\",\"showHeader\":true,\"headerColor\":\"#1976d2\",\"dataKeys\":[],\"mqttTopic\":\"ideaboard/messages/number\"}}],\"mqtt\":{\"url\":\"wss://broker.hivemq.com:8884/mqtt\",\"user\":\"\",\"pass\":\"\"}}"}