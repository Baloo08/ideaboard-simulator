{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"agSensor\">sensor</variable>\n  </variables>\n  <block type=\"sumo_accel_setup\" x=\"20\" y=\"20\">\n    <field name=\"SENSOR_VAR\" id=\"agSensor\">sensor</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"text_print\">\n            <value name=\"TEXT\">\n              <block type=\"sumo_accel_read\">\n                <field name=\"SENSOR_VAR\" id=\"agSensor\">sensor</field>\n                <field name=\"AXIS\">0</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"text_print\">\n                <value name=\"TEXT\">\n                  <block type=\"sumo_accel_read\">\n                    <field name=\"SENSOR_VAR\" id=\"agSensor\">sensor</field>\n                    <field name=\"AXIS\">1</field>\n                  </block>\n                </value>\n                <next>\n                  <block type=\"text_print\">\n                    <value name=\"TEXT\">\n                      <block type=\"sumo_accel_read\">\n                        <field name=\"SENSOR_VAR\" id=\"agSensor\">sensor</field>\n                        <field name=\"AXIS\">2</field>\n                      </block>\n                    </value>\n                    <next>\n                      <block type=\"text_print\">\n                        <value name=\"TEXT\">\n                          <block type=\"sumo_gyro_read\">\n                            <field name=\"SENSOR_VAR\" id=\"agSensor\">sensor</field>\n                            <field name=\"AXIS\">0</field>\n                          </block>\n                        </value>\n                        <next>\n                          <block type=\"text_print\">\n                            <value name=\"TEXT\">\n                              <block type=\"sumo_gyro_read\">\n                                <field name=\"SENSOR_VAR\" id=\"agSensor\">sensor</field>\n                                <field name=\"AXIS\">1</field>\n                              </block>\n                            </value>\n                            <next>\n                              <block type=\"text_print\">\n                                <value name=\"TEXT\">\n                                  <block type=\"sumo_gyro_read\">\n                                    <field name=\"SENSOR_VAR\" id=\"agSensor\">sensor</field>\n                                    <field name=\"AXIS\">2</field>\n                                  </block>\n                                </value>\n                                <next>\n                                  <block type=\"time_sleep\">\n                                    <value name=\"SECONDS\">\n                                      <block type=\"math_number\"><field name=\"NUM\">0.1</field></block>\n                                    </value>\n                                  </block>\n                                </next>\n                              </block>\n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}