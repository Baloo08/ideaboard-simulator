{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"controls_forever\" x=\"20\" y=\"20\">\n    <statement name=\"DO\">\n      <block type=\"ib_event_handler\">\n        <statement name=\"DO\">\n          <block type=\"controls_if\">\n            <mutation elseif=\"1\"></mutation>\n            <value name=\"IF0\">\n              <block type=\"ib_event_state\"><field name=\"STATE\">pressed</field></block>\n            </value>\n            <statement name=\"DO0\">\n              <block type=\"ib_pixel\">\n                <field name=\"COLOUR\">0, 255, 0</field>\n                <next>\n                  <block type=\"text_print\">\n                    <value name=\"TEXT\">\n                      <shadow type=\"text\"><field name=\"TEXT\">pressed</field></shadow>\n                    </value>\n                  </block>\n                </next>\n              </block>\n            </statement>\n            <value name=\"IF1\">\n              <block type=\"ib_event_state\"><field name=\"STATE\">released</field></block>\n            </value>\n            <statement name=\"DO1\">\n              <block type=\"ib_pixel\">\n                <field name=\"COLOUR\">0, 0, 0</field>\n                <next>\n                  <block type=\"text_print\">\n                    <value name=\"TEXT\">\n                      <shadow type=\"text\"><field name=\"TEXT\">released</field></shadow>\n                    </value>\n                  </block>\n                </next>\n              </block>\n            </statement>\n          </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n</xml>","dashboard":""}