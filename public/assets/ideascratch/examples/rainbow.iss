{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"rainbowI\">i</variable>\n  </variables>\n  <block type=\"controls_forever\" x=\"20\" y=\"20\">\n    <statement name=\"DO\">\n      <block type=\"controls_for\">\n        <field name=\"VAR\" id=\"rainbowI\">i</field>\n        <value name=\"FROM\">\n          <block type=\"math_number\"><field name=\"NUM\">0</field></block>\n        </value>\n        <value name=\"TO\">\n          <block type=\"math_number\"><field name=\"NUM\">255</field></block>\n        </value>\n        <value name=\"BY\">\n          <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n        </value>\n        <statement name=\"DO\">\n          <block type=\"ib_arcoiris\">\n            <value name=\"VALUE\">\n              <block type=\"variables_get\">\n                <field name=\"VAR\" id=\"rainbowI\">i</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"time_sleep\">\n                <value name=\"SECONDS\">\n                  <block type=\"math_number\"><field name=\"NUM\">0.01</field></block>\n                </value>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n</xml>","dashboard":""}