{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"controls_forever\" x=\"20\" y=\"20\">\n    <statement name=\"DO\">\n      <block type=\"ib_motors\">\n        <value name=\"MOTOR1\">\n          <block type=\"math_number\"><field name=\"NUM\">0.5</field></block>\n        </value>\n        <value name=\"MOTOR2\">\n          <block type=\"math_number\"><field name=\"NUM\">0.5</field></block>\n        </value>\n        <next>\n          <block type=\"time_sleep\">\n            <value name=\"SECONDS\">\n              <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n            </value>\n            <next>\n              <block type=\"ib_motors\">\n                <value name=\"MOTOR1\">\n                  <block type=\"math_number\"><field name=\"NUM\">0</field></block>\n                </value>\n                <value name=\"MOTOR2\">\n                  <block type=\"math_number\"><field name=\"NUM\">0</field></block>\n                </value>\n                <next>\n                  <block type=\"time_sleep\">\n                    <value name=\"SECONDS\">\n                      <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                    </value>\n                    <next>\n                      <block type=\"ib_motors\">\n                        <value name=\"MOTOR1\">\n                          <block type=\"math_number\"><field name=\"NUM\">-0.5</field></block>\n                        </value>\n                        <value name=\"MOTOR2\">\n                          <block type=\"math_number\"><field name=\"NUM\">-0.5</field></block>\n                        </value>\n                        <next>\n                          <block type=\"time_sleep\">\n                            <value name=\"SECONDS\">\n                              <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                            </value>\n                            <next>\n                              <block type=\"ib_motors\">\n                                <value name=\"MOTOR1\">\n                                  <block type=\"math_number\"><field name=\"NUM\">0</field></block>\n                                </value>\n                                <value name=\"MOTOR2\">\n                                  <block type=\"math_number\"><field name=\"NUM\">0</field></block>\n                                </value>\n                                <next>\n                                  <block type=\"time_sleep\">\n                                    <value name=\"SECONDS\">\n                                      <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                                    </value>\n                                  </block>\n                                </next>\n                              </block>\n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>","dashboard":""}