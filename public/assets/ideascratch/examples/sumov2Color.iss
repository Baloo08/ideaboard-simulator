{
  "version": 2,
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"sumoVar\">sumo</variable>\n    <variable id=\"colorVar\">color</variable>\n  </variables>\n  <block type=\"sumov2_setup\" x=\"20\" y=\"20\">\n    <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"ib_event_handler\">\n            <statement name=\"DO\">\n              <block type=\"controls_if\">\n                <value name=\"IF0\">\n                  <block type=\"ib_event_state\">\n                    <field name=\"STATE\">pressed</field>\n                  </block>\n                </value>\n                <statement name=\"DO0\">\n                  <block type=\"variables_set\">\n                    <field name=\"VAR\" id=\"colorVar\">color</field>\n                    <value name=\"VALUE\">\n                      <block type=\"sumov2_measure_color\">\n                        <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                      </block>\n                    </value>\n                    <next>\n                      <block type=\"text_print\">\n                        <value name=\"TEXT\">\n                          <block type=\"variables_get\">\n                            <field name=\"VAR\" id=\"colorVar\">color</field>\n                          </block>\n                        </value>\n                        <next>\n                          <block type=\"text_print\">\n                            <value name=\"TEXT\">\n                              <block type=\"sumov2_color_name\">\n                                <value name=\"COLOR\">\n                                  <block type=\"variables_get\">\n                                    <field name=\"VAR\" id=\"colorVar\">color</field>\n                                  </block>\n                                </value>\n                              </block>\n                            </value>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </statement>\n              </block>\n            </statement>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n  <block type=\"sumov2_color_table\" x=\"520\" y=\"20\">\n    <field name=\"TOLERANCE\">0.08</field>\n    <field name=\"MARGIN\">0.05</field>\n    <statement name=\"ROWS\">\n      <block type=\"sumov2_color_row\">\n        <field name=\"NAME\">red</field>\n        <field name=\"R\">0.8</field>\n        <field name=\"G\">0.06</field>\n        <field name=\"B\">0.14</field>\n        <next>\n          <block type=\"sumov2_color_row\">\n            <field name=\"NAME\">green</field>\n            <field name=\"R\">0.19</field>\n            <field name=\"G\">0.52</field>\n            <field name=\"B\">0.29</field>\n            <next>\n              <block type=\"sumov2_color_row\">\n                <field name=\"NAME\">blue</field>\n                <field name=\"R\">0.06</field>\n                <field name=\"G\">0.22</field>\n                <field name=\"B\">0.72</field>\n                <next>\n                  <block type=\"sumov2_color_row\">\n                    <field name=\"NAME\">yellow</field>\n                    <field name=\"R\">0.48</field>\n                    <field name=\"G\">0.41</field>\n                    <field name=\"B\">0.11</field>\n                    <next>\n                      <block type=\"sumov2_color_row\">\n                        <field name=\"NAME\">purple</field>\n                        <field name=\"R\">0.33</field>\n                        <field name=\"G\">0.13</field>\n                        <field name=\"B\">0.53</field>\n                        <next>\n                          <block type=\"sumov2_color_row\">\n                            <field name=\"NAME\">orange</field>\n                            <field name=\"R\">0.68</field>\n                            <field name=\"G\">0.17</field>\n                            <field name=\"B\">0.15</field>\n                            <next>\n                              <block type=\"sumov2_color_row\">\n                                <field name=\"NAME\">desk</field>\n                                <field name=\"R\">0.3</field>\n                                <field name=\"G\">0.35</field>\n                                <field name=\"B\">0.35</field>\n                              </block>\n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}