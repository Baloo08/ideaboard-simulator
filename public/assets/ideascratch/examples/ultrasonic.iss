{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"sonarVar\">sonar</variable>\n  </variables>\n  <block type=\"sumo_ultrasonic_setup\" x=\"20\" y=\"20\">\n    <field name=\"SENSOR_VAR\" id=\"sonarVar\">sonar</field>\n    <field name=\"TRIG\">board.IO26</field>\n    <field name=\"ECHO\">board.IO25</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"text_print\">\n            <value name=\"TEXT\">\n              <block type=\"sumo_ultrasonic_read\">\n                <field name=\"SENSOR_VAR\" id=\"sonarVar\">sonar</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"time_sleep\">\n                <value name=\"SECONDS\">\n                  <block type=\"math_number\"><field name=\"NUM\">0.5</field></block>\n                </value>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}