{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"servoVar\">myServo</variable>\n  </variables>\n  <block type=\"ib_servo_setup\" x=\"20\" y=\"20\">\n    <field name=\"SERVO_VAR\" id=\"servoVar\">myServo</field>\n    <field name=\"PIN\">board.IO4</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"ib_servo_angle\">\n            <field name=\"SERVO_VAR\" id=\"servoVar\">myServo</field>\n            <value name=\"ANGLE\">\n              <block type=\"math_number\"><field name=\"NUM\">0</field></block>\n            </value>\n            <next>\n              <block type=\"time_sleep\">\n                <value name=\"SECONDS\">\n                  <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                </value>\n                <next>\n                  <block type=\"ib_servo_angle\">\n                    <field name=\"SERVO_VAR\" id=\"servoVar\">myServo</field>\n                    <value name=\"ANGLE\">\n                      <block type=\"math_number\"><field name=\"NUM\">180</field></block>\n                    </value>\n                    <next>\n                      <block type=\"time_sleep\">\n                        <value name=\"SECONDS\">\n                          <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                        </value>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}