{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"mqttVar\">mqtt</variable>\n  </variables>\n  <block type=\"mqtt_setup\" x=\"20\" y=\"20\">\n    <field name=\"CLIENT_VAR\" id=\"mqttVar\">mqtt</field>\n    <field name=\"SSID\">your_ssid</field>\n    <field name=\"WIFI_PASS\">your_password</field>\n    <field name=\"BROKER\">broker.hivemq.com</field>\n    <field name=\"PORT\">1883</field>\n    <field name=\"MQTT_USER\"></field>\n    <field name=\"MQTT_PASS\"></field>\n    <next>\n      <block type=\"mqtt_subscribe\">\n        <field name=\"CLIENT_VAR\" id=\"mqttVar\">mqtt</field>\n        <value name=\"TOPIC\">\n          <shadow type=\"text\"><field name=\"TEXT\">ideaboard/messages</field></shadow>\n        </value>\n        <next>\n          <block type=\"controls_forever\">\n            <statement name=\"DO\">\n              <block type=\"mqtt_loop\">\n                <field name=\"CLIENT_VAR\" id=\"mqttVar\">mqtt</field>\n                <next>\n                  <block type=\"mqtt_on_message\">\n                    <field name=\"CLIENT_VAR\" id=\"mqttVar\">mqtt</field>\n                    <statement name=\"DO\">\n                      <block type=\"text_print\">\n                        <value name=\"TEXT\">\n                          <block type=\"text_join\">\n                            <mutation items=\"3\"></mutation>\n                            <value name=\"ADD0\">\n                              <block type=\"mqtt_received_topic\"></block>\n                            </value>\n                            <value name=\"ADD1\">\n                              <block type=\"text\"><field name=\"TEXT\">: </field></block>\n                            </value>\n                            <value name=\"ADD2\">\n                              <block type=\"mqtt_received_message\"></block>\n                            </value>\n                          </block>\n                        </value>\n                      </block>\n                    </statement>\n                  </block>\n                </next>\n              </block>\n            </statement>\n          </block>\n        </next>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":"{\"widgets\":[{\"type\":\"text-input\",\"col\":6,\"row\":1,\"width\":11,\"height\":3,\"config\":{\"label\":\"Send to Ideaboard\",\"showHeader\":true,\"headerColor\":\"#1976d2\",\"dataKey\":\"\",\"mqttTopic\":\"ideaboard/messages\"}}],\"mqtt\":{\"url\":\"wss://broker.hivemq.com:8884/mqtt\",\"user\":\"\",\"pass\":\"\"}}"}