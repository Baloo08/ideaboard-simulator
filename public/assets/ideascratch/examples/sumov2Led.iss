{
  "version": 2,
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"sumoVar\">sumo</variable>\n  </variables>\n  <block type=\"sumov2_setup\" x=\"20\" y=\"20\">\n    <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"sumov2_led\">\n            <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n            <value name=\"R\">\n              <block type=\"math_number\">\n                <field name=\"NUM\">255</field>\n              </block>\n            </value>\n            <value name=\"G\">\n              <block type=\"math_number\">\n                <field name=\"NUM\">0</field>\n              </block>\n            </value>\n            <value name=\"B\">\n              <block type=\"math_number\">\n                <field name=\"NUM\">0</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"time_sleep\">\n                <value name=\"SECONDS\">\n                  <block type=\"math_number\">\n                    <field name=\"NUM\">0.5</field>\n                  </block>\n                </value>\n                <next>\n                  <block type=\"sumov2_led\">\n                    <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                    <value name=\"R\">\n                      <block type=\"math_number\">\n                        <field name=\"NUM\">0</field>\n                      </block>\n                    </value>\n                    <value name=\"G\">\n                      <block type=\"math_number\">\n                        <field name=\"NUM\">255</field>\n                      </block>\n                    </value>\n                    <value name=\"B\">\n                      <block type=\"math_number\">\n                        <field name=\"NUM\">0</field>\n                      </block>\n                    </value>\n                    <next>\n                      <block type=\"time_sleep\">\n                        <value name=\"SECONDS\">\n                          <block type=\"math_number\">\n                            <field name=\"NUM\">0.5</field>\n                          </block>\n                        </value>\n                        <next>\n                          <block type=\"sumov2_led\">\n                            <field name=\"SUMO_VAR\" id=\"sumoVar\">sumo</field>\n                            <value name=\"R\">\n                              <block type=\"math_number\">\n                                <field name=\"NUM\">0</field>\n                              </block>\n                            </value>\n                            <value name=\"G\">\n                              <block type=\"math_number\">\n                                <field name=\"NUM\">0</field>\n                              </block>\n                            </value>\n                            <value name=\"B\">\n                              <block type=\"math_number\">\n                                <field name=\"NUM\">255</field>\n                              </block>\n                            </value>\n                            <next>\n                              <block type=\"time_sleep\">\n                                <value name=\"SECONDS\">\n                                  <block type=\"math_number\">\n                                    <field name=\"NUM\">0.5</field>\n                                  </block>\n                                </value>\n                              </block>\n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>"
