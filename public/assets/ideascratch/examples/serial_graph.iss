{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"controls_forever\" x=\"30\" y=\"30\">\n    <statement name=\"DO\">\n      <block type=\"controls_every\">\n        <value name=\"SECONDS\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n        <statement name=\"DO\">\n          <block type=\"dashboard_send\">\n            <mutation items=\"1\"></mutation>\n            <value name=\"KEY0\"><shadow type=\"text\"><field name=\"TEXT\">number</field></shadow></value>\n            <value name=\"VALUE0\">\n              <block type=\"math_random_int\">\n                <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n                <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n              </block>\n            </value>\n          </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n</xml>","dashboard":"{\"widgets\":[{\"type\":\"line-graph\",\"col\":1,\"row\":1,\"width\":14,\"height\":10,\"config\":{\"label\":\"Random Number\",\"showHeader\":true,\"headerColor\":\"#1976d2\",\"dataKeys\":[\"number\"],\"mqttTopic\":\"\"}}],\"mqtt\":{\"url\":\"wss://broker.hivemq.com:8884/mqtt\",\"user\":\"\",\"pass\":\"\"}}"}