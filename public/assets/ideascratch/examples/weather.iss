{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"explorer_setup\" x=\"20\" y=\"20\">\n    <next>\n      <block type=\"explorer_matrix_fill\">\n        <field name=\"VALUE\">0</field>\n        <next>\n          \n              <block type=\"controls_forever\">\n                <statement name=\"DO\">\n                  <block type=\"controls_if\">\n                    <mutation elseif=\"1\"></mutation>\n                    <value name=\"IF0\">\n                      <block type=\"explorer_button_state\"><field name=\"BTN\">0</field><field name=\"STATE\">pressed</field></block>\n                    </value>\n                    <statement name=\"DO0\">\n                      <block type=\"explorer_scroll_text\">\n                        <value name=\"TEXT\">\n                          <block type=\"text_join\">\n                            <mutation items=\"2\"></mutation>\n                            <value name=\"ADD0\">\n                              <block type=\"explorer_temp\"></block>\n                            </value>\n                            <value name=\"ADD1\">\n                              <block type=\"text\"><field name=\"TEXT\">C</field></block>\n                            </value>\n                          </block>\n                        </value>\n                        <value name=\"SPEED\">\n                          <shadow type=\"math_number\"><field name=\"NUM\">0.02</field></shadow>\n                        </value>\n                        <next>\n                          <block type=\"explorer_matrix_fill\">\n                            <field name=\"VALUE\">0</field>\n                            <next>\n                              \n                                  <block type=\"time_sleep\">\n                                    <value name=\"SECONDS\">\n                                      <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                                    </value>\n                                  </block>\n                                \n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </statement>\n                    <value name=\"IF1\">\n                      <block type=\"explorer_button_state\"><field name=\"BTN\">1</field><field name=\"STATE\">pressed</field></block>\n                    </value>\n                    <statement name=\"DO1\">\n                      <block type=\"explorer_scroll_text\">\n                        <value name=\"TEXT\">\n                          <block type=\"text_join\">\n                            <mutation items=\"2\"></mutation>\n                            <value name=\"ADD0\">\n                              <block type=\"explorer_humid\"></block>\n                            </value>\n                            <value name=\"ADD1\">\n                              <block type=\"text\"><field name=\"TEXT\">H</field></block>\n                            </value>\n                          </block>\n                        </value>\n                        <value name=\"SPEED\">\n                          <shadow type=\"math_number\"><field name=\"NUM\">0.02</field></shadow>\n                        </value>\n                        <next>\n                          <block type=\"explorer_matrix_fill\">\n                            <field name=\"VALUE\">0</field>\n                            <next>\n                              \n                                  <block type=\"time_sleep\">\n                                    <value name=\"SECONDS\">\n                                      <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                                    </value>\n                                  </block>\n                                \n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </statement>\n                    <next>\n                      <block type=\"time_sleep\">\n                        <value name=\"SECONDS\">\n                          <block type=\"math_number\"><field name=\"NUM\">0.05</field></block>\n                        </value>\n                      </block>\n                    </next>\n                  </block>\n                </statement>\n              </block>\n            \n        </next>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}