{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"controls_forever\" x=\"70\" y=\"30\">\n    <statement name=\"DO\">\n      <block type=\"dashboard_on_receive\">\n        <statement name=\"DO\">\n          <block type=\"controls_if\">\n            <value name=\"IF0\">\n              <block type=\"logic_compare\"><field name=\"OP\">EQ</field>\n                <value name=\"A\"><block type=\"dashboard_key\"></block></value>\n                <value name=\"B\"><block type=\"text\"><field name=\"TEXT\">joy</field></block></value>\n              </block>\n            </value>\n            <statement name=\"DO0\">\n              <block type=\"controls_if\">\n                <mutation elseif=\"3\"></mutation>\n                <value name=\"IF0\">\n                  <block type=\"logic_compare\"><field name=\"OP\">EQ</field>\n                    <value name=\"A\"><block type=\"dashboard_value\"></block></value>\n                    <value name=\"B\"><block type=\"text\"><field name=\"TEXT\">up</field></block></value>\n                  </block>\n                </value>\n                <statement name=\"DO0\"><block type=\"procedures_callnoreturn\"><mutation name=\"forward\"></mutation></block></statement>\n                <value name=\"IF1\">\n                  <block type=\"logic_compare\"><field name=\"OP\">EQ</field>\n                    <value name=\"A\"><block type=\"dashboard_value\"></block></value>\n                    <value name=\"B\"><block type=\"text\"><field name=\"TEXT\">down</field></block></value>\n                  </block>\n                </value>\n                <statement name=\"DO1\"><block type=\"procedures_callnoreturn\"><mutation name=\"backward\"></mutation></block></statement>\n                <value name=\"IF2\">\n                  <block type=\"logic_compare\"><field name=\"OP\">EQ</field>\n                    <value name=\"A\"><block type=\"dashboard_value\"></block></value>\n                    <value name=\"B\"><block type=\"text\"><field name=\"TEXT\">left</field></block></value>\n                  </block>\n                </value>\n                <statement name=\"DO2\"><block type=\"procedures_callnoreturn\"><mutation name=\"left\"></mutation></block></statement>\n                <value name=\"IF3\">\n                  <block type=\"logic_compare\"><field name=\"OP\">EQ</field>\n                    <value name=\"A\"><block type=\"dashboard_value\"></block></value>\n                    <value name=\"B\"><block type=\"text\"><field name=\"TEXT\">right</field></block></value>\n                  </block>\n                </value>\n                <statement name=\"DO3\"><block type=\"procedures_callnoreturn\"><mutation name=\"right\"></mutation></block></statement>\n              </block>\n            </statement>\n          </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n  <block type=\"procedures_defnoreturn\" x=\"550\" y=\"70\">\n    <field name=\"NAME\">forward</field>\n    <statement name=\"STACK\">\n      <block type=\"ib_motors\">\n        <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n        <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n        <next><block type=\"time_sleep\">\n          <value name=\"SECONDS\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n          <next><block type=\"ib_motors\">\n            <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n            <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n          </block></next>\n        </block></next>\n      </block>\n    </statement>\n  </block>\n  <block type=\"procedures_defnoreturn\" x=\"550\" y=\"270\">\n    <field name=\"NAME\">backward</field>\n    <statement name=\"STACK\">\n      <block type=\"ib_motors\">\n        <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">-0.5</field></shadow></value>\n        <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">-0.5</field></shadow></value>\n        <next><block type=\"time_sleep\">\n          <value name=\"SECONDS\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n          <next><block type=\"ib_motors\">\n            <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n            <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n          </block></next>\n        </block></next>\n      </block>\n    </statement>\n  </block>\n  <block type=\"procedures_defnoreturn\" x=\"930\" y=\"50\">\n    <field name=\"NAME\">left</field>\n    <statement name=\"STACK\">\n      <block type=\"ib_motors\">\n        <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">-0.5</field></shadow></value>\n        <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n        <next><block type=\"time_sleep\">\n          <value name=\"SECONDS\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n          <next><block type=\"ib_motors\">\n            <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n            <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n          </block></next>\n        </block></next>\n      </block>\n    </statement>\n  </block>\n  <block type=\"procedures_defnoreturn\" x=\"930\" y=\"270\">\n    <field name=\"NAME\">right</field>\n    <statement name=\"STACK\">\n      <block type=\"ib_motors\">\n        <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n        <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">-0.5</field></shadow></value>\n        <next><block type=\"time_sleep\">\n          <value name=\"SECONDS\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n          <next><block type=\"ib_motors\">\n            <value name=\"MOTOR1\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n            <value name=\"MOTOR2\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n          </block></next>\n        </block></next>\n      </block>\n    </statement>\n  </block>\n</xml>","dashboard":"{\"widgets\":[{\"type\":\"joystick\",\"col\":10,\"row\":1,\"width\":10,\"height\":13,\"config\":{\"label\":\"Joystick\",\"showHeader\":true,\"headerColor\":\"#1976d2\",\"dataKey\":\"joy\",\"mqttTopic\":\"\",\"upValue\":\"up\",\"downValue\":\"down\",\"leftValue\":\"left\",\"rightValue\":\"right\",\"joyColor\":\"#00695c\"}}],\"mqtt\":{\"url\":\"wss://broker.hivemq.com:8884/mqtt\",\"user\":\"\",\"pass\":\"\"}}"}