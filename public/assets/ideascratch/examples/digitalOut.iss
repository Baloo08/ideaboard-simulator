{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"doutVar\">myOutput</variable>\n  </variables>\n  <block type=\"ib_digital_out_setup\" x=\"20\" y=\"20\">\n    <field name=\"PIN_VAR\" id=\"doutVar\">myOutput</field>\n    <field name=\"PIN\">board.IO27</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"ib_digital_out_write\">\n            <field name=\"PIN_VAR\" id=\"doutVar\">myOutput</field>\n            <field name=\"VALUE\">True</field>\n            <next>\n              <block type=\"time_sleep\">\n                <value name=\"SECONDS\">\n                  <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                </value>\n                <next>\n                  <block type=\"ib_digital_out_write\">\n                    <field name=\"PIN_VAR\" id=\"doutVar\">myOutput</field>\n                    <field name=\"VALUE\">False</field>\n                    <next>\n                      <block type=\"time_sleep\">\n                        <value name=\"SECONDS\">\n                          <block type=\"math_number\"><field name=\"NUM\">1</field></block>\n                        </value>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}