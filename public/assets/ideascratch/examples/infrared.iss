{"version":2,"blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"sumo_ir_setup\" x=\"20\" y=\"20\">\n    <field name=\"S1_NAME\">Sensor1</field>\n    <field name=\"S1_PIN\">board.IO33</field>\n    <field name=\"S2_NAME\">Sensor2</field>\n    <field name=\"S2_PIN\">board.IO32</field>\n    <field name=\"S3_NAME\">Sensor3</field>\n    <field name=\"S3_PIN\">board.IO35</field>\n    <field name=\"S4_NAME\">Sensor4</field>\n    <field name=\"S4_PIN\">board.IO34</field>\n    <next>\n      <block type=\"controls_forever\">\n        <statement name=\"DO\">\n          <block type=\"text_print\">\n            <value name=\"TEXT\">\n              <block type=\"sumo_ir_read\"><field name=\"SENSOR\">1</field></block>\n            </value>\n            <next>\n              <block type=\"text_print\">\n                <value name=\"TEXT\">\n                  <block type=\"sumo_ir_read\"><field name=\"SENSOR\">2</field></block>\n                </value>\n                <next>\n                  <block type=\"text_print\">\n                    <value name=\"TEXT\">\n                      <block type=\"sumo_ir_read\"><field name=\"SENSOR\">3</field></block>\n                    </value>\n                    <next>\n                      <block type=\"text_print\">\n                        <value name=\"TEXT\">\n                          <block type=\"sumo_ir_read\"><field name=\"SENSOR\">4</field></block>\n                        </value>\n                        <next>\n                          <block type=\"time_sleep\">\n                            <value name=\"SECONDS\">\n                              <block type=\"math_number\"><field name=\"NUM\">0.5</field></block>\n                            </value>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>","dashboard":""}